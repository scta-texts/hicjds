      <div xml:id="hicjds-d1e4305"><!-- hicjds-b4d18-19q1 -->
        <head>Quaestio 1</head>
        <head type="question-title">Utrum potestas clavium tantummodo se extendat ad poenam temporalem</head>
        <!-- <div alias="hiq-d18-19q1-p1"> -->
          <p>
            <lb ed="#V" n="60" type="fixed=600"/>COMMENTARIUS
          </p>
          <p>
            <lb ed="#V" n="61"/>In hac distinctione movet quaestionem:
            <lb ed="#V" n="62"/>An scilicet potestas clavium se extendat
            <lb ed="#V" n="63"/>ad poenam temporalem tantum.
            Argumen<lb ed="#V" n="64" break="no"/>ta pro utraque parte proponit, sed
            resolu<lb ed="#V" n="65" break="no"/>tionem quaestionis transfert in
            distincti<lb ed="#V" n="66" break="no"/>onem sequentem, in qua resolvit
            quaesti<lb ed="#V" n="67" break="no"/>,onem hic motam, et solvit argumenta
            <lb ed="#V" n="68"/>proposita, cujus ordinem sequemur.
            Vi<lb ed="#V" n="69" break="no"/>deatur ergo resolutio in praedicto loco.
          </p>
        <!--</div>-->
      </div>
