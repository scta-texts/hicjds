      <div xml:id="hicjds-d1e5273"><!-- hicjds-b4d46prae -->
        <head xml:id="hicjds-d1e5273-Hd1e99">Praeambulum</head>
        <!-- <div alias="hiq-d46prae"> -->
          <p xml:id="hicjds-d1e5273-d1e103">
            <lb ed="#V" n="34" type="fixed=399"/>COMMENTARIUS.
          </p>
          <p xml:id="hicjds-d1e5273-d1e108">
            <lb ed="#V" n="35"/>In hac distinctione agit Magister de
            at<lb ed="#V" n="36" break="no"/>tributis Dei, scilicet misericordia et
            ju<lb ed="#V" n="37" break="no"/>stitia, potissimum quoad damnatos: An
            <lb ed="#V" n="38"/>respectu illorum operetur Deus quoad
            <lb ed="#V" n="39"/>poenam inflictam ex utroque attributo.
            <lb ed="#V" n="40"/>Circa hanc distinctionem movet Doctor
            <lb ed="#V" n="41"/>quatuor quaestiones. Prima est, utrum in
            <cb ed="#V" n="b"/>
            <lb ed="#V" n="42"/>Deo sit justitia? Secunda quaestio, utrum
            <lb ed="#V" n="43"/>in Deo sit misericordia? Tertia quaestio,
            <lb ed="#V" n="44"/>utrum haec attributa distinguantur inter
            <lb ed="#V" n="45"/>se in Deo? Quarta est, quae spectat ad
            <lb ed="#V" n="46"/>scopum proprium hujus distinctionis.
            <lb ed="#V" n="47"/>an scilicet respectu poenae inflictae
            dam<lb ed="#V" n="48" break="no"/>natis concurrant justitia et
            misericor<lb ed="#V" n="49" break="no"/>dia?
          </p>
        <!--</div>-->
      </div>
