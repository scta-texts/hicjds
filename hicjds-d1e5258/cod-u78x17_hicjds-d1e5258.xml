      <div xml:id="hicjds-d1e5258"><!-- hicjds-b4d11prae -->
        <head>Praeambulum</head>
        <!-- <div alias="hiq-d11prae"> -->
          <p>
            <lb ed="#V" n="46" type="fixed=318"/>COMMENTARIUS.
          </p>
          <p>
            <lb ed="#V" n="47"/>(a) In hac distinctione agitur primo de
            <lb ed="#V" n="48"/>via ad Sacramentum, nempe de
            conver<lb ed="#V" n="49" break="no"/>sione et transubstantiatione; secundo, de
            <lb ed="#V" n="50"/>materia Sacramenti; eam absolvit Doctor
            <lb ed="#V" n="51"/>septem quaestionibus, quarum prima est
            <lb ed="#V" n="52"/>de possibilitate transubstantiationis;
            se<lb ed="#V" n="53" break="no"/>cunda, an possit quodlibet converti in
            <lb ed="#V" n="54"/>quodlibet? tertia, an panis convertatur in
            <lb ed="#V" n="55"/>corpus Christi? quarta, an panis
            conver<lb ed="#V" n="56" break="no"/>sus annihiletur? quinta, quibus verbis
            <lb ed="#V" n="57"/>possit exprimi haec conversio? sexta, de
            <lb ed="#V" n="58"/>natura et essentia panis convertibilis;
            <lb ed="#V" n="59"/>septima est, de materia calicis.
          </p>
        <!--</div>-->
      </div>
    </body>
