      <div xml:id="hicjds-d1e5343"><!-- hicjds-b4d50q4 -->
        <head>Quaestio 4</head>
        <head type="question-title">Utrum poena omnium damnatorum sit aequalis</head>
        <!-- <div alias="hiq-d50q4-p1"> -->
          <p>
            <lb ed="#V" n="60" type="fixed=549"/>COMMENTARIUS.
          </p>
          <p>
            <lb ed="#V" n="61"/>(g) Ultimo quoad totum quartum istum,
            <lb ed="#V" n="62"/>quaeritur, etc. Complet tractatum quarti
            <lb ed="#V" n="63"/>Sententiarum per tres quaestiones,
            qua<lb ed="#V" n="64" break="no"/>rum haec est prima. Secunda est de
            in<lb ed="#V" n="65" break="no"/>aequalitate gloriae beatorum, etc. Tertia
            <lb ed="#V" n="66"/>de inaequalitate gloriae corporum.
          </p>
        <!--</div>-->
      </div>
