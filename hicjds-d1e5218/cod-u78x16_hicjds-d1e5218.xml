      <div xml:id="hicjds-d1e5218"><!-- hicjds-b4d5prae -->
        <head>Praeambulum</head>
        <!-- <div alias="hiq-d5prae"> -->
          <p>
            <lb ed="#V" n="6" type="fixed=501"/>COMMENTARIUS.
          </p>
          <p>
            <lb ed="#V" n="7"/>In hac distinctione postquam hactenus
            <lb ed="#V" n="8"/>tractavit de essentialibus Sacramenti,
            <lb ed="#V" n="9"/>ejus effectu et suscipiente, agit de
            mi<lb ed="#V" n="10" break="no"/>nistro quoad statum ejus; in sequenti
            <lb ed="#V" n="11"/>vero agit de per se requisitis ex parte
            <lb ed="#V" n="12"/>ministri. Hac ergo distinctione quaerit
            <lb ed="#V" n="13"/>primo: An malitia ministri impediat
            <lb ed="#V" n="14"/>effectum Sacramenti si caetera adsint,
            <lb ed="#V" n="15"/>quae requiruntur? Secundo: an recipiens
            <lb ed="#V" n="16"/>Sacramentum scienter a malo ministro.
            <lb ed="#V" n="17"/>peccet mortaliter? Tertio: an licite
            mi<lb ed="#V" n="18" break="no"/>nistretur Baptismus, quando preesumitur
            <lb ed="#V" n="19"/>sequi periculum vitae corporalis?
          </p>
        <!--</div>-->
      </div>
    </body>
