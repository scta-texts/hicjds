      <div xml:id="hicjds-d1e5268"><!-- hicjds-b4d13prae -->
        <head>Praeambulum</head>
        <!-- <div alias="hiq-d13prae"> -->
          <p>
            <lb ed="#V" n="63" type="fixed=660"/>COMMENTARIUS.
          </p>
          <p>
            <lb ed="#V" n="64"/>(a) In hac distinctione, quae est ultima
            <lb ed="#V" n="65"/>hujus tractatus apud Magistrum, agitur
            <lb ed="#V" n="66"/>de ministro, eam duabus quaestionibus
            <lb ed="#V" n="67"/>absolvit Doctor, nempe, utrum sola
            di<lb ed="#V" n="68" break="no"/>vina actione fiat hoc Sacramentum? et,
            <lb ed="#V" n="69"/>an omnis Sacerdos illud ministerialiter
            <lb ed="#V" n="70"/>conficere possit? ubi etiam compendiose
            <lb ed="#V" n="71"/>agit, de iis quae requiruntur in
            sacrifi<lb ed="#V" n="72" break="no"/>cio Missae.
          </p>
        <!--</div>-->
      </div>
