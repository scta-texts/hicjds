    <body>
      <div xml:id="hicjds-d1e5208"><!-- hicjds-b4d3prae -->
        <head xml:id="hicjds-d1e5208-Hd1e101">Praeambulum</head>
        <!-- <div alias="hiq-d3prae"> -->
          <p xml:id="hicjds-d1e5208-d1e105">
            <pb ed="#V" n="274"/>
            <cb ed="#V" n="a"/>
            <lb ed="#V" n="1" type="fixed=274"/>COMMENTARIUS
          </p>
          <p xml:id="hicjds-d1e5208-d1e114">
            <lb ed="#V" n="2"/>(a) Supra Magister egit, etc. Hic exponit
            <lb ed="#V" n="3"/>Doctor ordinem. Postquam enim tractavit
            <lb ed="#V" n="4"/>de Sacramentis novae legis in genere,
            <lb ed="#V" n="5"/>subjecit etiam tractatum de Baptismo
            <lb ed="#V" n="6"/>Joannis, tanquam praeambulo ad
            tracta<lb ed="#V" n="7" break="no"/>tum de Baptismo Christi, quem explicat
            <lb ed="#V" n="8"/>in hac distinctione. Ejus argumentum
            <lb ed="#V" n="9"/>comprehendit Doctor quatuor
            quaestioni<lb ed="#V" n="10" break="no"/>bus, hoc ordine: Primo explicat quid
            <lb ed="#V" n="11"/>rei per definitionem, quae supponitur in
            <lb ed="#V" n="12"/>qualibet scientia. Secundo explicat partes
            <lb ed="#V" n="13"/>Sacramenti Baptismi; in secunda
            quaes<lb ed="#V" n="14" break="no"/>tione formam, quae est magis principalis
            <lb ed="#V" n="15"/>in composito; in tertia vero quaestione
            <lb ed="#V" n="16"/>agit de materia; in quarta vero, de
            insti<lb ed="#V" n="17" break="no"/>tutione ejus per ordinem ad causam
            effi<lb ed="#V" n="18" break="no"/>cientem, et de promulgatione et
            concur<lb ed="#V" n="19" break="no"/>rentia ejus cum Circumcisione.
          </p>
        <!--</div>-->
      </div>
    </body>
